# QueueLess local environment template.
# Copy to .env and replace every placeholder with a fresh random value.
# Never commit .env or reuse these secrets in a deployed environment.

MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_LOCAL_ROOT_PASSWORD
MYSQL_DATABASE=queueless_db
MYSQL_USER=queueless_user
MYSQL_PASSWORD=REPLACE_WITH_STRONG_LOCAL_DB_PASSWORD

# Use distinct random values. Example generator: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_BASE64_ENCODED
QUEUELESS_QR_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET

# Optional local frontend configuration, if needed by your setup
VITE_API_BASE_URL=http://localhost/api/v1
VITE_WS_URL=ws://localhost/ws
