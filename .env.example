# QueueLess SaaS Production Environment Variables Template

# Database Settings
MYSQL_ROOT_PASSWORD=change_this_root_password_in_production
MYSQL_DATABASE=queueless_db
MYSQL_USER=queueless_user
MYSQL_PASSWORD=change_this_db_password_in_production
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/queueless_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Redis Settings
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=change_this_super_secret_base64_jwt_key_with_at_least_64_characters
JWT_EXPIRATION=86400000

# Application Ports & URLs
PORT=8080
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8080/ws
